{
  "name": "karin-plugin-botweb",
  "version": "1.0.15",
  "author": "瑜笙",
  "type": "module",
  "description": "基于Karin编写的Bot面板",
  "homepage": "https://github.com/yusheng929/karin-plugin-botweb",
  "bugs": {
    "url": "https://github.com/yusheng929/karin-plugin-botweb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusheng929/karin-plugin-botweb.git"
  },
  "scripts": {
    "app": "node lib/app.js",
    "build": "tsc --noEmit && tsdown",
    "dev": "cross-env EBV_FILE=\"development.env\" node --import tsx src/app.ts",
    "pub": "npm publish --access public"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@karinjs/sqlite3": "^0.4.3"
  },
  "devDependencies": {
    "@karinjs/adapter-qqbot": "^2.2.1",
    "@karinjs/plugin-adapter-milky": "^1.3.3",
    "@types/express": "5.0.6",
    "cross-env": "10.1.0",
    "node-karin": "https://pkg.pr.new/node-karin@1484936"
  },
  "karin": {
    "main": "src/index.ts",
    "web": "lib/web.config.js",
    "ts-web": "src/web.config.ts",
    "apps": [
      "lib/apps"
    ],
    "ts-apps": [
      "src/apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config",
      "temp",
      "data"
    ]
  },
  "files": [
    "lib/",
    "resources/",
    "!lib/app.js",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ]
}